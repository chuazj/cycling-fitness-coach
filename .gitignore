# Credentials
.env

# Local Claude Code settings
.claude/

# Python bytecode / caches
__pycache__/
*.pyc
.pytest_cache/

# Virtualenvs (if created inside the repo)
.venv/
venv/
env/

# Coverage
.coverage
htmlcov/

# OS / IDE
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~

# Temp / backup
*.log
*.bak
*.tmp
*.orig

# Athlete-specific plan state (PII — see CLAUDE.md → "plans/ is gitignored")
# Ignore the entire directory so any future PII file is excluded by default;
# keep only the .gitkeep placeholder so the directory itself stays tracked.
plans/*
!plans/.gitkeep

# Script outputs containing athlete data (HRV, RHR, RPE, FTP, weight, training history)
# Anchored to repo root so test fixtures with the same name are unaffected.
# Globbed: ad-hoc suffixed variants (wellness7.json, readiness_0604.json) were slipping
# past exact-name rules and landing untracked in a repo that has a push remote.
/output*.json
/wellness*.json
/readiness*.json
/rpe_trend*.json
/summary*.json
/trend*.json
/prediction_report*.json
