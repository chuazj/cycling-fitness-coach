# Normalize line endings to LF in the working tree on all platforms.
# Avoids the "LF will be replaced by CRLF" warnings on Windows checkouts
# and the spurious whole-file diffs when comparing a OneDrive checkout
# (Git for Windows default = CRLF) against a non-OneDrive one (LF).

* text=auto eol=lf

# Explicit binary files — never normalize.
*.fit binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz binary
